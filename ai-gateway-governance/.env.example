# Direct baseline: Foundry / Azure OpenAI endpoint called with Entra ID (az login locally).
FOUNDRY_OPENAI_ENDPOINT=https://demo-swe.openai.azure.com
DIRECT_LARGE_DEPLOYMENT=gpt-6.1-sol

# AI Gateway runtime endpoint and aliases (created manually, see README).
GATEWAY_ENDPOINT=https://aigw-swe.swedencentral-01.ai.gateway.azure.com
GATEWAY_PRIMARY_MODEL=demo-swe/gpt-6-1-sol
GATEWAY_FALLBACK_MODEL=demo-swe/gpt-6-luna

# Dedicated runtime API keys. Backend only; never commit real values.
GATEWAY_APP_KEY=
GATEWAY_APP_KEY_NAME=summarizer-app
GATEWAY_BURST_KEY=
GATEWAY_BURST_KEY_NAME=burst-client

# Model IDs used to recognise the served model; list prices (USD / 1M tokens, Azure Retail Prices,
# gpt-6.1-sol / gpt-6-luna = Global Standard short context).
LARGE_MODEL_ID=gpt-6.1-sol
SMALL_MODEL_ID=gpt-6-luna
LARGE_MAX_OUTPUT_TOKENS=2500
SMALL_MAX_OUTPUT_TOKENS=1200
LARGE_PRICE_INPUT_PER_1M=2.00
LARGE_PRICE_CACHED_INPUT_PER_1M=0.10
LARGE_PRICE_OUTPUT_PER_1M=10.00
SMALL_PRICE_INPUT_PER_1M=0.10
SMALL_PRICE_CACHED_INPUT_PER_1M=0.01
SMALL_PRICE_OUTPUT_PER_1M=0.50

# Gateway decisions that make the app retry on the fallback alias.
# request_rate_limited is needed when the primary alias only has a request rate limit.
FALLBACK_ON=token_limit_exceeded,cost_limit_exceeded,request_rate_limited
# Alias the rate-limit burst targets. Empty = primary alias.
GATEWAY_BURST_MODEL=

# Per-tier generation parameters. Empty temperature = omit (reasoning models accept only the default).
LARGE_TEMPERATURE=
LARGE_REASONING_EFFORT=low
SMALL_TEMPERATURE=
SMALL_REASONING_EFFORT=low

REQUEST_TIMEOUT_SECONDS=120
AUDIT_LOG_PATH=logs/audit.jsonl
