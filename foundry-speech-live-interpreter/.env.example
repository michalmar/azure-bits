AZURE_CONFIG_DIR=/absolute/path/to/.azure-365
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_SPEECH_RESOURCE_NAME=
# AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com
PERSONAL_VOICE_ENABLED=false
MAX_SESSION_SECONDS=120

# Local development is anonymous. Azure deployment must enable reader auth.
AUTH_ENABLED=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# SESSION_SECRET=
# ALLOWED_USERS=tenant:*
